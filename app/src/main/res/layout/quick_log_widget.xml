                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ql_tile_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="0dp"
            android:background="@drawable/ql_tile"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ql_emoji_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/ql_label_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="4dp"
                android:textColor="#FFF5F6F8"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ql_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/ql_tile_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/ql_tile"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ql_emoji_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp" />
            <TextView
