                android:ellipsize="end"
                android:paddingHorizontal="4dp"
                android:textColor="#FFF5F6F8"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ql_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/ql_line"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/ql_line_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FF191C22"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/ql_line_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:text="EDIT"
            android:textColor="#FF1E6EBE"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/ql_line_undo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:text="UNDO"
            android:textColor="#FF1E6EBE"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
