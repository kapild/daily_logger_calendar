<?xml version="1.0" encoding="utf-8"?>
<!-- Quick log widget. Plain views, not Glance, so a tap redraws at once. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ql_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ql_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quick log"
            android:textColor="#FFF5F6F8"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/ql_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="✏️"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ql_row_0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/ql_tile_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/ql_tile"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ql_emoji_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/ql_label_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="4dp"
                android:textColor="#FFF5F6F8"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ql_tile_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/ql_tile"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ql_emoji_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/ql_label_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="4dp"
                android:textColor="#FFF5F6F8"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ql_tile_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="0dp"
            android:background="@drawable/ql_tile"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ql_emoji_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/ql_label_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="4dp"
                android:textColor="#FFF5F6F8"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ql_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/ql_tile_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
