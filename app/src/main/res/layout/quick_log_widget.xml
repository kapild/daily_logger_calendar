            <TextView
                android:id="@+id/ql_label_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="4dp"
                android:textColor="#FFF5F6F8"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
