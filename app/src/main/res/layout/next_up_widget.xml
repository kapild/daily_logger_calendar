<?xml version="1.0" encoding="utf-8"?>
<!-- Next Up widget: the last two events, a "now" line, the next two. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nu_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/nu_done_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/nu_done_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/nu_tile_done"
            android:orientation="vertical"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/nu_done_0_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FF6E747E"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:text="✓"
                    android:textColor="#FF969CA6"
                    android:textSize="11sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/nu_done_0_rel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#FF969CA6"
                android:textSize="11sp" />
            <ProgressBar
                android:id="@+id/nu_done_0_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/nu_bar_grey"
                android:scaleX="-1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nu_done_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="0dp"
            android:background="@drawable/nu_tile_done"
            android:orientation="vertical"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/nu_done_1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FF6E747E"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:text="✓"
                    android:textColor="#FF969CA6"
                    android:textSize="11sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/nu_done_1_rel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#FF969CA6"
                android:textSize="11sp" />
            <ProgressBar
                android:id="@+id/nu_done_1_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/nu_bar_grey"
                android:scaleX="-1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="#FFDE3C3C" />
        <TextView
            android:id="@+id/nu_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/nu_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="#FFDE3C3C" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nu_next_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:background="@drawable/nu_tile_next"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/nu_next_0_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF181A20"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/nu_next_0_rel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:maxLines="1"
                android:textColor="#FFDE3C3C"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/nu_next_0_times"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textColor="#FF6E747E"
            android:textSize="11sp" />
        <ProgressBar
                android:id="@+id/nu_next_0_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/nu_bar_red" />
        <ProgressBar
                android:id="@+id/nu_next_0_bar_now"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/nu_bar_orange"
                android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/nu_next_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/nu_tile_next"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/nu_next_1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF181A20"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/nu_next_1_rel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:maxLines="1"
                android:textColor="#FFDE3C3C"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/nu_next_1_times"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textColor="#FF6E747E"
            android:textSize="11sp" />
        <ProgressBar
                android:id="@+id/nu_next_1_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/nu_bar_red" />
        <ProgressBar
                android:id="@+id/nu_next_1_bar_now"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/nu_bar_orange"
                android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/nu_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#FF6E747E"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
